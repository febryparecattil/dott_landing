# Copy to .env, fill in, then: chmod 600 .env
# .env is gitignored - never commit it.

# --- admin dashboard at /nimda -------------------------------------------
# Generate both of these with:  venv/bin/python tools/hash_password.py
# ADMIN_PASSWORD_HASH is a PBKDF2 hash, not the password itself.
# The panel returns 404 until both are set.
ADMIN_PASSWORD_HASH=
SECRET_KEY=

# Set to false only for local http development.
SESSION_COOKIE_SECURE=true
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15

# Optional: restrict /nimda to specific client IPs or prefixes.
# Anything else gets a 404. Empty means no IP restriction.
ADMIN_IP_ALLOWLIST=

# --- database ------------------------------------------------------------
DB_PATH=/var/lib/dott/dott.db

# --- public form throttle ------------------------------------------------
FORM_MAX_SUBMISSIONS=10
FORM_WINDOW_MINUTES=60

# Reverse proxies in front of the app. Must match reality - too high lets a
# client spoof its own IP via X-Forwarded-For and evade the rate limits.
TRUSTED_PROXY_HOPS=1

# --- email notification (optional) ---------------------------------------
# Submissions are stored in the database regardless. This is only the ping.
# Leave EMAIL_ENABLED=false until a real app password exists.
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=10
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_RECIPIENTS=subin@dott.health,febry@dott.health,jithu@dott.health
WAITLIST_SUBJECT=New Dott Health waitlist signup
REGISTER_SUBJECT=New Dott Health practitioner registration
